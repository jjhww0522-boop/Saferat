# demo uses only virtual data. See docs/P2_SETUP.md before using live.
APP_MODE=demo
# off | mock | live (live is not connected in P1)
AI_MODE=mock
OCR_MODE=mock
# For the P2 workspace use APP_MODE=live and AI_MODE=off, OCR_MODE=off.
# Server-only project settings; do not use an admin/service key in the app.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional setup/inspection worker ONLY. The Next.js app never reads this key.
# SUPABASE_SERVICE_ROLE_KEY=
